# Critical Minerals Signal Hunter — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# =============================================================================
# GOOGLE / GEMINI
# =============================================================================
GOOGLE_API_KEY=AIzaSy...

# =============================================================================
# LANGSMITH (LangChain tracing)
# =============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=critical-minerals-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# =============================================================================
# TELEGRAM BOT (Phase 4)
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# =============================================================================
# SUBSTACK (Phase 4 — optional if using manual paste workflow)
# =============================================================================
SUBSTACK_PUBLICATION_URL=
# SUBSTACK_API_KEY=  # uncomment when Substack API is available

# =============================================================================
# DATABASE
# =============================================================================
# SQLite path (local dev). Switch to Supabase URL for cloud deployment.
DATABASE_URL=sqlite:///./data/signals.db

# =============================================================================
# PIPELINE CONFIGURATION
# =============================================================================
# Watchlist config file path
WATCHLIST_PATH=watchlist.yaml

# Override default pipeline settings (all optional)
# EDGAR_RATE_LIMIT_RPS=10
# PRICE_LOOKBACK_DAYS=30
# NEWS_LOOKBACK_HOURS=48
# MAX_FILINGS_PER_TICKER=5
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TEMPERATURE=0
# GEMINI_MAX_TOKENS=1024

# =============================================================================
# FASTAPI
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# API_SECRET_KEY=  # uncomment and set for production auth

# =============================================================================
# CRON / SCHEDULER
# =============================================================================
# APScheduler cron expression for daily pipeline run (UTC)
PIPELINE_CRON_HOUR=6
PIPELINE_CRON_MINUTE=0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
# LOG_FORMAT=json  # set to 'json' for structured logging in production

# =============================================================================
# FORUM SCRAPER — Canadian Immigration Pain Points
# =============================================================================
# Uses GOOGLE_API_KEY + GEMINI_MODEL defined above — no extra API keys needed.

# Supabase free cloud Postgres (https://supabase.com — free tier: 500MB, 2 projects)
# Get these from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Scraper tuning (optional — defaults shown)
SCRAPER_THREADS_PER_SECTION=30
SCRAPER_POSTS_PER_THREAD=10
SCRAPER_DELAY=1.5
